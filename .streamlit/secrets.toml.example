# Copy this file to .streamlit/secrets.toml for local private settings.
# Do not commit the real secrets.toml file to GitHub.

# Optional: only needed when you enable LLM mode.
OPENAI_API_KEY = "sk-your-key-here"
OPENAI_BASE_URL = "https://api.openai.com/v1"
OPENAI_MODEL = "gpt-4o-mini"

# Optional: public site root used when Streamlit cannot detect the current URL.
DEEPLISTER_PUBLIC_BASE_URL = "https://your-app.streamlit.app"

# Optional: only needed for the developer GitHub OAuth gate.
[github_oauth]
client_id = "your-github-oauth-client-id"
client_secret = "your-github-oauth-client-secret"
redirect_uri = "https://your-app.streamlit.app/?page=developer"
allowed_login = "sunrise-yc"
allowed_user_id = 292528736
